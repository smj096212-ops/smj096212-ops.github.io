rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 붙여넣고 "게시(Publish)"하세요.
//
// 이 규칙이 막는 것: 저장된 문서는 절대 수정/삭제 불가(불변), 2048을 달성한 판(reachedGoal=true,
// maxTile=2048)이 아니면 애초에 기록 자체를 생성할 수 없음, rankScore가 elapsedMs와 다르게
// 조작된 경우 거부, 로그인(익명 인증 포함) 없이는 쓰기 불가.
//
// 이 규칙이 막지 못하는 것: 브라우저 개발자도구로 우리 앱과 똑같은 형태의 "그럴듯한" 값을 직접 써넣는
// 행위 자체는 막을 수 없습니다. 클라이언트가 직접 DB에 쓰는 구조상 근본적인 한계이며, 완전히 막으려면
// Cloud Functions 등 서버 측 검증이 필요합니다(유료 플랜 필요, 이번 버전 범위 밖).
service cloud.firestore {
  match /databases/{database}/documents {
    match /results/{resultId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['maxTile', 'elapsedMs', 'reachedGoal', 'rankScore', 'nickname', 'country', 'createdAt'])
        && request.resource.data.maxTile == 2048
        && request.resource.data.reachedGoal == true
        && request.resource.data.elapsedMs is number
        && request.resource.data.elapsedMs > 300
        && request.resource.data.rankScore is number
        && request.resource.data.rankScore == request.resource.data.elapsedMs
        && (!('nickname' in request.resource.data)
            || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 20))
        && (!('country' in request.resource.data)
            || (request.resource.data.country is string && request.resource.data.country.matches('^[A-Z]{2}$')))
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
